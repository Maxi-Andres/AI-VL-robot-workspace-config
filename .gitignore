# Per-machine reindex signatures for the codebase-memory graph. Machine state, not config.
.reindex-state/

# Personal overrides, never shared.
settings.local.json

# coverage.sh scratch: a throwaway venv (kept out of every repo's environment on purpose)
# and the per-repo .coverage databases. Both are regenerated on demand; delete to reset.
# `.covenv/` also self-ignores — python -m venv drops a `.gitignore` with `*` inside it.
.covenv/
.coverage-data/

