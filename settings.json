{
  "enabledMcpjsonServers": [
    "codebase-memory-mcp"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/reindex-if-needed.sh\" 2>/dev/null || true",
            "statusMessage": "Reindexing codebase-memory for the repos that changed...",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/reindex-if-needed.sh\" 2>/dev/null || true",
            "statusMessage": "Reindexing codebase-memory for the repo that just changed...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/reindex-if-needed.sh\" 2>/dev/null || true",
            "statusMessage": "Reindexing codebase-memory for the repos that changed...",
            "async": true
          }
        ]
      }
    ]
  }
}
